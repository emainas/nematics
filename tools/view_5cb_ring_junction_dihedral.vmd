# VMD scene for the 5CB ring-to-pentyl junction dihedral used in Figure 8.
# Run from anywhere with:
#   vmd -e /absolute/path/to/tools/view_5cb_ring_junction_dihedral.vmd

set script_dir [file dirname [file normalize [info script]]]
set repo_root [file dirname $script_dir]
set local_pdb [file join $script_dir "5cb_molecule_frame.pdb"]
set repository_pdb [file join $repo_root "data-processed" "5cb" "amoeba-pt2.7" \
    "end-to-end-order" "visualization" "5cb_molecule_frame.pdb"]

# A downloaded copy placed beside this script takes precedence. The repository
# path is only a convenience fallback when running inside the nematics tree.
if {[file isfile $local_pdb]} {
    set pdb_file $local_pdb
} else {
    set pdb_file $repository_pdb
}

if {![file isfile $pdb_file]} {
    error "Place 5cb_molecule_frame.pdb beside this VMD script"
}

set molid [mol new $pdb_file type pdb waitfor all]

display projection Orthographic
display depthcue off
color Display Background white
axes location Off

# Show the complete 5CB molecule in gray.
mol delrep 0 $molid
mol representation Licorice 0.12 14 14
mol color ColorID 6
mol material AOShiny
mol selection all
mol addrep $molid

proc serial_xyz {molid serial} {
    set sel [atomselect $molid "serial $serial"]
    if {[$sel num] != 1} {
        $sel delete
        error "Expected exactly one atom with PDB serial $serial"
    }
    set xyz [lindex [$sel get {x y z}] 0]
    $sel delete
    return $xyz
}

proc serial_index {molid serial} {
    set sel [atomselect $molid "serial $serial"]
    if {[$sel num] != 1} {
        $sel delete
        error "Expected exactly one atom with PDB serial $serial"
    }
    set index [lindex [$sel get index] 0]
    $sel delete
    return $index
}

proc draw_bond {molid start end color radius} {
    graphics $molid color $color
    graphics $molid material AOShiny
    graphics $molid cylinder $start $end radius $radius resolution 24 filled yes
}

proc draw_atom {molid point color} {
    graphics $molid color $color
    graphics $molid material AOShiny
    graphics $molid sphere $point radius 0.31 resolution 24
}

# Figure-8 torsion: C09-C10-C14-C15 = local/PDB serials 8-10-15-16.
set serials {8 10 15 16}
lassign $serials sa sb sc sd
set a [serial_xyz $molid $sa]
set b [serial_xyz $molid $sb]
set c [serial_xyz $molid $sc]
set d [serial_xyz $molid $sd]

# Orange is the C09-C10-C14 reference plane, which is approximately the
# aromatic ring plane. Cyan is the C10-C14-C15 chain-junction plane.
graphics $molid color 3
graphics $molid material Transparent
graphics $molid triangle $a $b $c

graphics $molid color 10
graphics $molid material Transparent
graphics $molid triangle $b $c $d

# The shared C10-C14 bond is the torsional hinge, highlighted in yellow.
draw_bond $molid $a $b 3 0.20
draw_bond $molid $b $c 4 0.25
draw_bond $molid $c $d 10 0.20

draw_atom $molid $a 3
draw_atom $molid $b 4
draw_atom $molid $c 4
draw_atom $molid $d 10

set ia [serial_index $molid $sa]
set ib [serial_index $molid $sb]
set ic [serial_index $molid $sc]
set id [serial_index $molid $sd]
set chi_signed [measure dihed [list $ia $ib $ic $id] molid $molid frame 0]
set chi_360 [expr {fmod($chi_signed + 360.0, 360.0)}]

# Atom and plane labels. ColorID 16 is black in VMD's default palette.
graphics $molid color 16
graphics $molid material AOShiny
graphics $molid text [vecadd $a {-1.0 0.8 0.3}] "C09" size 1.15 thickness 2
graphics $molid text [vecadd $b {-0.8 -0.9 0.3}] "C10" size 1.15 thickness 2
graphics $molid text [vecadd $c {0.5 0.8 0.3}] "C14" size 1.15 thickness 2
graphics $molid text [vecadd $d {-0.8 -1.0 0.3}] "C15" size 1.15 thickness 2

set all_sel [atomselect $molid all]
set center [measure center $all_sel]
$all_sel delete
graphics $molid text [vecadd $center {-7.0 4.0 0.0}] \
    [format "chi(C09-C10-C14-C15) = %.1f deg" $chi_360] size 1.25 thickness 2
graphics $molid text [vecadd $center {-7.0 2.9 0.0}] \
    "orange: ring reference plane; cyan: chain-junction plane" size 0.95 thickness 2
graphics $molid text [vecadd $center {-7.0 1.9 0.0}] \
    "yellow C10-C14 bond: shared torsional hinge" size 0.95 thickness 2

display resetview
puts "Loaded $pdb_file"
puts [format "5CB ring-junction torsion C09-C10-C14-C15: signed %.3f deg; wrapped %.3f deg" \
    $chi_signed $chi_360]
puts "Orange plane: C09-C10-C14 (approximately the aromatic ring plane)"
puts "Cyan plane:   C10-C14-C15 (the first chain-junction plane)"
puts "Yellow bond:  C10-C14 (the shared rotation axis, not an out-of-plane vector)"
